ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OCR_LOCAL_URL=http://comptaos-ocr:8000
# Recours aux API Mistral + fournisseur IA seulement si explicitement active.
OCR_REMOTE_FALLBACK=false
# Laisse au worker CPU le temps de redresser et lire les photos difficiles.
OCR_LOCAL_TIMEOUT_MS=180000
OPENAI_API_KEY=

WORKSPACE_PATH=../workspace
# Autoriser la sauvegarde vers un chemin Git local (Electron l'active automatiquement).
ALLOW_LOCAL_GIT_SYNC=false
PORT=3001
HOST=127.0.0.1

# Clé API locale optionnelle. Génération :
# node -e "console.log(require('crypto').randomUUID())"
LOCAL_API_KEY=

# Authentification serveur (obligatoire pour une instance exposée sur Internet)
AUTH_ENABLED=true
HTTPS_ONLY=true
# En production, fournir une valeur aléatoire longue via l'environnement.
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PROPLUS=

# Powens Open Banking (PSD2)
# En production hébergée, utiliser ces variables plutôt que le fichier local.
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_USER_TOKEN=
